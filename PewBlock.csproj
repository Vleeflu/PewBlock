<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window behind the game. Use Exe to see raylib's log output. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed only by Audio.LoadTrimmed, which scans raw sample memory to cut silence. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sound files and textures are copied next to the exe (bin/.../source/, bin/.../assets/) so they load from anywhere. -->
    <None Include="source\**\*.mp3;source\**\*.wav;source\**\*.ogg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/AssetGen is a separate program (it generates assets/textures); keep it out of the game. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
